{
  // Opens Talent Radar with fictional demonstration data in GitHub Codespaces.
  // Uses GitHub's standard Codespaces image (Docker included); the app and its PostgreSQL
  // database are then built and started from the repository's own Dockerfile.
  "name": "Talent Radar demo (fictional data)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Talent Radar", "protocol": "http", "onAutoForward": "openBrowser" }
  },
  "postStartCommand": "bash .devcontainer/start-demo.sh"
}
