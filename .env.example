# Talent Radar — configuration. Copy to .env (docker compose) or set as App Service / Container App settings.
# Values marked SECRET belong in a secret store (Azure Key Vault references, or a protected .env), never in git.

# ── Required ────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://talent-radar.example.com     # public HTTPS address; used for SSO redirects and same-origin checks
APP_DOMAIN=talent-radar.example.com          # docker compose / Caddy only
POSTGRES_PASSWORD=                           # SECRET — docker compose only (database container password)
# DATABASE_URL=postgres://user:password@host:5432/talentradar   # SECRET — set this instead when using a managed database
# DATABASE_SSL=true                          # required for Azure Database for PostgreSQL

# First administrator (only used while the users table is empty; must change password at first sign-in)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=                    # SECRET — remove after first start

# ── Sign-in ─────────────────────────────────────────────────────────────────
LOCAL_LOGIN_ENABLED=true                     # set false once single sign-on works
SSO_ENABLED=false
SSO_ISSUER=                                  # https://login.microsoftonline.com/<tenant-id>/v2.0
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=                           # SECRET
SSO_ALLOWED_DOMAINS=                         # e.g. planradar.com (comma separated); empty = any domain the tenant issues
SSO_AUTO_PROVISION=false                     # true: unknown colleagues get SSO_DEFAULT_ROLE at first sign-in
SSO_DEFAULT_ROLE=viewer
SESSION_TTL_HOURS=12

# ── Behaviour ───────────────────────────────────────────────────────────────
DEMO_DATA=false                              # true loads fictional data into an EMPTY database and shows demo sign-in. Never in production.
APP_TIMEZONE=Africa/Cairo                    # business timezone for deadlines and week boundaries
TRUST_PROXY=1                                # number of reverse proxies in front of the app
# FRAME_ANCESTORS='self' https://teams.microsoft.com   # only if the app is embedded as a Teams tab

# ── Greenhouse (optional; requires IT / Greenhouse admin authorisation) ─────
GREENHOUSE_CLIENT_ID=
GREENHOUSE_CLIENT_SECRET=                    # SECRET
# GREENHOUSE_TOKEN_URL=https://auth.greenhouse.io/token
# GREENHOUSE_BASE_URL=https://harvest.greenhouse.io/v3
# GREENHOUSE_JOB_URL_TEMPLATE=https://app.greenhouse.io/sdash/{id}
# GREENHOUSE_PATH_HIRING_TEAM=               # confirm against the tenant's v3 reference before enabling
# GREENHOUSE_SYNC_HOURS=0                    # >0 refreshes automatically every N hours

# ── Optional AI wording (company-approved, OpenAI-compatible endpoint such as Azure OpenAI) ──
AI_PROVIDER=none                             # none | openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=                                  # SECRET
# AI_API_KEY_HEADER=api-key                  # Azure OpenAI resource keys use the "api-key" header

# ── Optional Microsoft Teams channel webhook (Workflows → "When a Teams webhook request is received") ──
TEAMS_WEBHOOK_URL=                           # SECRET
